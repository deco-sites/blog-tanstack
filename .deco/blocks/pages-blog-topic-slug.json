{
  "name": "Tópico",
  "path": "/topics/:slug",
  "sections": [
    {
      "__resolveType": "site/sections/Blog/BlogHeader.tsx",
      "logoAlt": "Blog",
      "showReadingProgress": false
    },
    {
      "__resolveType": "site/sections/Blog/BlogHome.tsx",
      "posts": {
        "__resolveType": "site/loaders/BlogpostList.ts",
        "sortBy": "date_desc",
        "count": 100,
        "filterBy": "category",
        "slug": {
          "__resolveType": "website/functions/requestToParam.ts",
          "param": "slug"
        }
      },
      "perPage": 10,
      "baseUrl": "/topics/",
      "structuredData": false
    }
  ],
  "__resolveType": "website/pages/Page.tsx",
  "seo": {
    "__resolveType": "blog/sections/Seo/SeoBlogPostListing.tsx",
    "jsonLD": {
      "__resolveType": "blog/loaders/BlogpostListing.ts",
      "slug": {
        "__resolveType": "website/functions/requestToParam.ts",
        "param": "slug"
      },
      "count": 10
    }
  }
}
