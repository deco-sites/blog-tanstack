  "flows": [
    {
      "id": "search-dialog",
      "viewports": [
        "desktop"
      ],
      "start": "/",
      "note": "desktop: header search button opens the palette, type a query, Enter submits to /search",
      "steps": [
        {
          "action": "click",
          "selector": "[data-open-search]:visible"
        },
        {
          "action": "waitFor",
          "selector": "dialog[open] input"
        },
        {
          "action": "type",
          "selector": "dialog[open] input",
          "text": "react"
        },
        {
          "action": "wait",
          "ms": 300
        },
        {
          "action": "screenshot",
          "name": "open-with-results"
        },
        {
          "action": "press",
          "selector": "dialog[open] input",
          "key": "Enter"
        },
        {
          "action": "waitForURL",
          "pattern": "**/search?q=react"
        },
        {
          "action": "settle"
        },
        {
          "action": "url",
          "name": "after-submit"
        },
        {
          "action": "screenshot",
          "name": "results-page",
          "fullPage": true
        }
      ]
    },
    {
      "id": "search-dialog-mobile",
      "viewports": [
        "mobile"
      ],
      "start": "/",
      "note": "mobile: open drawer, tap Buscar, type a query, Enter submits to /search",
      "steps": [
        {
          "action": "click",
          "selector": "button[aria-label='Abrir menu']"
        },
        {
          "action": "wait",
          "ms": 300
        },
        {
          "action": "click",
          "selector": "[data-open-search]:visible"
        },
        {
          "action": "waitFor",
          "selector": "dialog[open] input"
        },
        {
          "action": "type",
          "selector": "dialog[open] input",
          "text": "react"
        },
        {
          "action": "wait",
          "ms": 300
        },
        {
          "action": "screenshot",
          "name": "open-with-results"
        },
        {
          "action": "press",
          "selector": "dialog[open] input",
          "key": "Enter"
        },
        {
          "action": "waitForURL",
          "pattern": "**/search?q=react"
        },
        {
          "action": "settle"
        },
        {
          "action": "url",
          "name": "after-submit"
        },
        {
          "action": "screenshot",
          "name": "results-page",
          "fullPage": true
        }
      ]
    },
    {
      "id": "search-shortcut",
      "viewports": [
        "desktop"
      ],
      "start": "/topics",
      "note": "Ctrl+K opens the search palette",
      "steps": [
        {
          "action": "keyboard",
          "key": "Control+k"
        },
        {
          "action": "waitFor",
          "selector": "dialog[open] input"
        },
        {
          "action": "screenshot",
          "name": "palette-open"
        },
        {
          "action": "keyboard",
          "key": "Escape"
        },
        {
          "action": "wait",
          "ms": 200
        },
        {
          "action": "screenshot",
          "name": "palette-closed"
        }
      ]
    },
    {
      "id": "mobile-drawer",
      "viewports": [
        "mobile"
      ],
      "start": "/",
      "note": "open and close the mobile drawer menu, then navigate via it",
      "steps": [
        {
          "action": "click",
          "selector": "button[aria-label='Abrir menu']"
        },
        {
          "action": "wait",
          "ms": 300
        },
        {
          "action": "screenshot",
          "name": "drawer-open"
        },
        {
          "action": "click",
          "selector": "button[aria-label='Fechar menu']"
        },
        {
          "action": "wait",
          "ms": 300
        },
        {
          "action": "screenshot",
          "name": "drawer-closed"
        },
        {
          "action": "click",
          "selector": "button[aria-label='Abrir menu']"
        },
        {
          "action": "wait",
          "ms": 300
        },
        {
          "action": "click",
          "selector": "[aria-label='Menu mobile'] a[href='/topics']"
        },
        {
          "action": "waitForURL",
          "pattern": "**/topics"
        },
        {
          "action": "settle"
        },
        {
          "action": "url",
          "name": "after-nav"
        },
        {
          "action": "screenshot",
          "name": "topics",
          "fullPage": true
        }
      ]
    },
    {
      "id": "home-pagination",
      "viewports": [
        "desktop",
        "mobile"
      ],
      "start": "/",
      "note": "client-side pagination next/prev",
      "steps": [
        {
          "action": "click",
          "selector": "a[href='/?page=2']"
        },
        {
          "action": "waitForURL",
          "pattern": "**/?page=2"
        },
        {
          "action": "settle"
        },
        {
          "action": "url",
          "name": "page-2"
        },
        {
          "action": "screenshot",
          "name": "page-2",
          "fullPage": true
        },
        {
          "action": "click",
          "selector": "a[href='/']:has-text('Anterior'), a[rel='prev']"
        },
        {
          "action": "waitForURL",
          "pattern": "**/"
        },
        {
          "action": "settle"
        },
        {
          "action": "url",
          "name": "back-to-1"
        },
        {
          "action": "screenshot",
          "name": "page-1",
          "fullPage": true
        }
      ]
    },
    {
      "id": "post-reading",
      "viewports": [
        "desktop",
        "mobile"
      ],
      "start": "/web-performance-guide-2025",
      "note": "hero header turns opaque on scroll, reading-progress bar, TOC active state",
      "steps": [
        {
          "action": "scrollTo",
          "fraction": 0
        },
        {
          "action": "screenshot",
          "name": "top"
        },
        {
          "action": "scrollTo",
          "fraction": 0.5
        },
        {
          "action": "screenshot",
          "name": "middle"
        },
        {
          "action": "scrollTo",
          "fraction": 1
        },
        {
          "action": "screenshot",
          "name": "bottom"
        }
      ]
    },
    {
      "id": "client-nav",
      "viewports": [
        "desktop"
      ],
      "start": "/",
      "note": "SPA navigation home -> first post -> category -> author via in-page links",
      "steps": [
        {
          "action": "click",
          "selector": "main a[href='/seo-geo-guide-2025']"
        },
        {
          "action": "waitForURL",
          "pattern": "**/seo-geo-guide-2025"
        },
        {
          "action": "settle"
        },
        {
          "action": "url",
          "name": "post"
        },
        {
          "action": "head",
          "name": "post-head"
        },
        {
          "action": "screenshot",
          "name": "post",
          "fullPage": true
        },
        {
          "action": "click",
          "selector": "header a[href='/topics']"
        },
        {
          "action": "waitForURL",
          "pattern": "**/topics"
        },
        {
          "action": "settle"
        },
        {
          "action": "url",
          "name": "topics"
        },
        {
          "action": "head",
          "name": "topics-head"
        },
        {
          "action": "screenshot",
          "name": "topics",
          "fullPage": true
        }
      ]
    }
  ],
