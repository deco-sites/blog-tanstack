{
  "name": "blog-tanstack",
  "version": "1.0.0",
  "type": "module",
  "description": "Professional blog template powered by TanStack Start + deco.cx",
  "scripts": {
    "dev": "vite dev",
    "dev:clean": "rm -rf node_modules/.vite .wrangler/state .tanstack && vite dev",
    "generate": "tsx node_modules/@decocms/blocks-cli/scripts/generate.ts --site blog-tanstack",
    "generate:routes": "tsr generate",
    "build": "npm run generate && tsr generate && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "author": "deco.cx",
  "license": "MIT",
  "packageManager": "bun@1.3.5",
  "overrides": {
    "@decocms/blocks": "7.77.2",
    "@decocms/blocks-admin": "7.77.2"
  },
  "dependencies": {
    "@decocms/apps-blog": "7.77.2",
    "@decocms/apps-website": "7.77.2",
    "@decocms/blocks": "7.77.2",
    "@decocms/blocks-admin": "7.77.2",
    "@decocms/tanstack": "7.77.2",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-router": "1.166.7",
    "@tanstack/react-start": "1.166.8",
    "@tanstack/react-store": "0.9.2",
    "@tanstack/store": "0.9.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.27.0",
    "@decocms/blocks-cli": "7.77.2",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/router-cli": "1.166.7",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "daisyui": "^5.5.19",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.2.1",
    "ts-morph": "^27.0.2",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.72.0"
  }
}
