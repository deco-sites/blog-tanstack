{
  "name": "blog-tanstack",
  "account_id": "c95fc4cec7fc52453228d9db170c372c",
  "compatibility_date": "2026-02-14",
  // nodejs_compat: AsyncLocalStorage and the Node APIs Start relies on.
  // no_handle_cross_request_promise_resolution: the CMS shares one content load across requests.
  "compatibility_flags": ["nodejs_compat", "no_handle_cross_request_promise_resolution"],
  "main": "./src/worker-entry.ts",
  "workers_dev": true,
  "preview_urls": true,
  // Tail worker — captures uncaught throws, exceededCpu/exceededMemory and raw
  // console.error from this worker and forwards them to deco-otel-ingest.
  "tail_consumers": [
    { "service": "deco-otel-tail" }
  ],
  "vars": {
    "DECO_SITE_NAME": "blog-tanstack",
    "DECO_ENV_NAME": "production"
  }
}
